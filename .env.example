# Canonical production origin (no trailing slash). Preview/dev builds are noindex automatically
# unless this is the production domain AND VERCEL_ENV is "production" (or NODE_ENV=production off Vercel).
SITE_URL=https://tailoredluxurytours.com

# Where enquiries are delivered through FormSubmit (the business inbox). Also shown on the site as the contact email.
# After the first enquiry FormSubmit emails this inbox once to activate delivery: click the link in that email.
CONTACT_EMAIL=


# Business WhatsApp number, digits only with country code, no "+" (e.g. 212600000000). Leave empty to hide WhatsApp CTAs.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=

# Optional: Plausible analytics domain (cookieless, no consent banner needed). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: webmaster verification tokens (the content="..." value of each engine's meta tag). Leave empty to omit.
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
BAIDU_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Optional: IndexNow key (8-128 letters, digits or dashes). Served at /indexnow-key.txt; submit URLs with: node scripts/indexnow.mjs
INDEXNOW_KEY=
